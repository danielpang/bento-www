NEXT_PUBLIC_SIGNUP_URL=https://app.usebento.ai
NEXT_PUBLIC_GITHUB_URL=https://github.com/danielpang/bento
NEXT_PUBLIC_SITE_URL=https://usebento.ai

# Use the SAME project token as app.usebento.ai (the "Bento" PostHog project),
# so marketing $pageview events and completed signup attribution land in one
# project. Set it and every marketing page records $pageview and $pageleave;
# leave it empty and the site loads no analytics at all.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Enable only after creating the experiment and verifying identity across domains.
# Disabled: production serves control, local development serves redesign.
NEXT_PUBLIC_MARKETING_EXPERIMENT_ENABLED=false
